# Optional for source-information mode; required for Alpaca price confirmation.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Required: existing Telegram bot and destination
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Default and recommended no-cost oil mode
OIL_DATA_MODE=free-proxy

# Optional fallback for the broader market scanner
TWELVE=

# Focused equity structural-intelligence layer.
# Keep the list small; runtime validation hard-caps it at eight symbols.
# Energy Fuels is context-only: its sole notification owner is Energy Fuels Fokus.
# UUUU/EFR/EF2 cannot send a competing 777 equity alert, regardless of this list.
RADAR_EQUITY_WATCHLIST=UUUU,MU,MP,INTC
STRUCTURAL_SCAN_MINUTES=15

# Combined primary-source information radar; no subscriptions or LLM calls.
RADAR_EF_PRIMARY_ENABLED=false
# Informational policy/EIA/ECB notices work without market-data credentials.
# They never confirm a price movement or authorize a trade.
RADAR_GENERAL_INFO_MODE=true
# Optional existing Twelve Basic key, isolated from the legacy quote provider.
# Internal non-display analysis only; no public/private price publication.
RADAR_TWELVE_BASIC_CONTEXT=false
TWELVE_BASIC_API_KEY=
EF_POLL_MINUTES=10
RADAR_FREE_ONLY=true
# probe-only disables ordinary alerts while a one-time connection test is checked.
RADAR_DELIVERY_MODE=live
RADAR_DELIVERY_PROBE_ID=
# Optional read-only export of the completed recovery snapshot; keep secret.
RADAR_BACKUP_ACCESS_KEY=

# Kimi research is disabled by default. The only accepted active mode is
# "shadow"; "live" is deliberately rejected by the runtime.
KIMI_RESEARCH_MODE=off
KIMI_RESEARCH_FILE=/data/kimi-research-shadow.json

# Optional only if a compatible futures plan is deliberately added later
# MASSIVE_API_KEY=

# Container listener. Keep 3000 unless a reverse proxy is configured.
RADAR_PORT=3000
RADAR_BIND_ADDRESS=0.0.0.0
