# Required: existing free Alpaca Basic/IEX credentials
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Required: existing Telegram bot and destination
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Default and recommended no-cost oil mode
OIL_DATA_MODE=free-proxy

# Optional fallback for the broader market scanner
TWELVE=

# Optional only if a compatible futures plan is deliberately added later
# MASSIVE_API_KEY=

# Container listener. Keep 3000 unless a reverse proxy is configured.
RADAR_PORT=3000
RADAR_BIND_ADDRESS=0.0.0.0

